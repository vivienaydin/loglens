# Local Python environments and generated bytecode must stay off GitHub.
.venv/
venv/
__pycache__/
*.py[cod]

# Test runners and coverage tools generate these locally.
.pytest_cache/
.coverage
htmlcov/
.test-tmp/

# Generated reports are outputs, not source files.
/endpoints.csv
/reports/

# Machine-specific editor settings and local secrets are not project source.
.vscode/
.idea/
.env
.env.*

# Operating systems may create these files automatically.
.DS_Store
Thumbs.db
